{
	"name": "bashgenie",
	"version": "0.0.1",
	"description": "CLI tool that translates your question to a shell command",
	"files": ["dist"],
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"bashgenie": "dist/index.js"
	},
	"scripts": {
		"test:watch": "vitest",
		"test": "vitest run --coverage",
		"build": "tsc",
		"ci": "npm run build && npm run format:check",
		"biome:fix": "npm run biome:check -- --write",
		"biome:check": "biome check"
	},
	"author": "Alessio Scarfone",
	"license": "MIT",
	"dependencies": {
		"@ai-sdk/google": "^1.1.20",
		"@ai-sdk/openai": "^1.2.1",
		"@clack/prompts": "^0.10.0",
		"ai": "^4.1.54",
		"conf": "^13.1.0",
		"kleur": "^4.1.5",
		"ora": "^8.2.0",
		"zod": "^3.24.2"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.13.10",
		"@vitest/coverage-v8": "^3.0.8",
		"typescript": "^5.8.2",
		"vitest": "^3.0.8"
	}
}
